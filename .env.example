DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Gmail SMTP (required for sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
# 16-char Google App Password (not your normal Gmail password)
SMTP_PASS=xxxx xxxx xxxx xxxx

# Must be the same Gmail (or a Send-as alias on that account)
MAIL_FROM=yourgmail@gmail.com
# Display name shown in inbox
MAIL_FROM_NAME=BOA
MAIL_REPLY_TO=yourgmail@gmail.com
